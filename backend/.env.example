# Copy to .env and adjust for your machine.
# For a separate test database, copy .env.test.example to .env.test

NODE_ENV=development
PORT=4001

# Option A: single connection string (recommended)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/doctor_crm

# Separate test database (Jest / npm test) — never mix with dev data
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/doctor_crm_test

# Staging pre-production environment
STAGING_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/doctor_crm_staging

# Production (use PRODUCTION_DATABASE_URL on deploy — never in local .env)
# PRODUCTION_DATABASE_URL=postgresql://USER:PASSWORD@host:5432/doctor_crm_production

# Option B: individual fields (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=doctor_crm
DB_USER=doctorcrm
DB_PASSWORD=doctorcrm

# DB_PROFILE: development | test | staging | production
DB_PROFILE=development

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=info

SUPER_ADMIN_EMAIL=admin@doctorcrm.com
SUPER_ADMIN_PASSWORD=Admin@123456
DEMO_USER_PASSWORD=Demo@123456

FRONTEND_URL=http://localhost:5173
EMAIL_FROM=MaatriDev <info@maatridev.com>
SUPPORT_PHONE=9211611187
SUPPORT_EMAIL=info@maatridev.com

# SMS — set MSG91_AUTH_KEY for live SMS (India)
SMS_PROVIDER=stub
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your_key_here
# SMS_SENDER_ID=MAATRD

# WhatsApp — Twilio optional
WHATSAPP_PROVIDER=stub
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SMTP — set for live email (use info@maatridev.com mailbox)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=info@maatridev.com
# SMTP_PASS=your_app_password
