{
  "name": "doctor-crm-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:staging": "cross-env NODE_ENV=staging node src/server.js",
    "start:production": "cross-env NODE_ENV=production node src/server.js",
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "dev:staging": "cross-env NODE_ENV=staging nodemon src/server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:test": "cross-env NODE_ENV=test sequelize-cli db:migrate",
    "migrate:staging": "cross-env NODE_ENV=staging sequelize-cli db:migrate",
    "migrate:production": "cross-env NODE_ENV=production sequelize-cli db:migrate",
    "db:create:test": "node scripts/db-setup.js --test-only",
    "db:setup:staging": "node scripts/db-setup.js --staging-only",
    "db:setup:all": "node scripts/db-setup.js --all",
    "db:setup": "node scripts/db-setup.js",
    "seed": "node src/seeders/run-seed.js",
    "seed:staging": "cross-env NODE_ENV=staging ALLOW_SEED=true node src/seeders/run-seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --watch"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "uuid": "^11.0.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  }
}
