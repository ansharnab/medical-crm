NODE_ENV=staging
PORT=4002

STAGING_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/doctor_crm_staging
DB_HOST=localhost
DB_PORT=5432
DB_NAME=doctor_crm_staging
DB_USER=doctorcrm
DB_PASSWORD=doctorcrm

REDIS_URL=redis://localhost:6379/2

JWT_ACCESS_SECRET=staging-access-secret-min-32-characters!!
JWT_REFRESH_SECRET=staging-refresh-secret-min-32-characters!!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CORS_ORIGIN=https://staging.yourdomain.com
COOKIE_SECURE=true
LOG_LEVEL=info

SUPER_ADMIN_EMAIL=admin@doctorcrm.com
SUPER_ADMIN_PASSWORD=CHANGE_ME

FRONTEND_URL=https://staging.yourdomain.com
EMAIL_FROM=Doctor CRM Staging <noreply@doctorcrm.com>
